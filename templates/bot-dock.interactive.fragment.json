{
  "projects": {
    "my-project": {
      "api_key_env": "MYPROJECT_BOTDOCK_API_KEY",
      "callback_url": "http://127.0.0.1:8092/botdock/query",
      "callback_key_env": "MYPROJECT_CALLBACK_KEY",
      "routes": [
        {
          "command": "/status",
          "description": "查詢專案狀態"
        },
        {
          "command": "/help",
          "description": "查看指令說明",
          "aliases": [
            "/start"
          ]
        }
      ]
    }
  },
  "bots": {
    "my-bot": {
      "token_env": "MYPROJECT_TELEGRAM_BOT_TOKEN",
      "project_id": "my-project",
      "receive_updates": true,
      "destinations": {
        "owner": 123456789
      },
      "allowed_chat_ids": [
        123456789
      ],
      "allowed_user_ids": [
        123456789
      ]
    }
  }
}
